# ==========================================
# SafeSight backend configuration
# ==========================================

# 1. GEMINI — choose ONE
# a) Vertex AI (recommended on Google Cloud; uses Application Default Credentials)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# b) Gemini API key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model fallback chain
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash

# 2. DATABASE
DATABASE_URL=postgresql+pg8000://user:password@host:5432/ehs_safety

# 3. EVIDENCE STORAGE (optional; local disk when unset)
# GCS_BUCKET_NAME=your-private-evidence-bucket
# PUBLIC_API_BASE_URL=https://your-api-url

# 4. SECURITY
JWT_SECRET_KEY=change-me

# 5. ALERTS (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
FONNTE_TOKEN=your_fonnte_token
WA_TARGET_PHONE=your_target_phone
